# FutureFunded production environment example
# Never commit real secret values.

# App
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=replace-with-long-random-secret
PUBLIC_BASE_URL=https://your-production-domain.example
FF_PUBLIC_BASE_URL=https://your-production-domain.example

# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Operator access
FF_OPERATOR_ACCESS_TOKEN=replace-with-long-random-token

# Stripe live mode
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_PUBLISHABLE_KEY=pk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# PayPal live mode
PAYPAL_ENV=live
PAYPAL_CLIENT_ID=replace-me
PAYPAL_CLIENT_SECRET=replace-me

# Mail, optional
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
