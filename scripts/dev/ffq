#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

mode="${1:-changed}"

usage() {
  echo "Usage: scripts/dev/ffq [changed|platform|campaign|login|onboarding|dashboard|operator|ops|buttons|functional|e2e|product|all|ui|clip|ui-full|prelive|money|full]"
}

load_operator_token() {
  if [[ -z "${FF_OPERATOR_ACCESS_TOKEN:-}" && -f /tmp/ff_operator_token ]]; then
    export FF_OPERATOR_ACCESS_TOKEN="$(cat /tmp/ff_operator_token)"
  fi
}

sync_operator_server_env() {
  load_operator_token

  if [[ -z "${FF_OPERATOR_ACCESS_TOKEN:-}" ]]; then
    echo "ERROR: FF_OPERATOR_ACCESS_TOKEN is empty and /tmp/ff_operator_token was not found."
    echo "Run the token setup before authenticated dashboard smoke."
    exit 1
  fi

  export FF_ASSET_V="ffq-token-sync-$(date +%Y%m%d%H%M%S)"

  if command -v pm2 >/dev/null 2>&1; then
    pm2 restart futurefunded-web --update-env >/dev/null
    sleep 2
  fi
}

run_timed() {
  local label="$1"
  local seconds="$2"
  shift 2

  echo
  echo "▶ $label"
  echo "------------------------------------------------------------"

  if command -v timeout >/dev/null 2>&1; then
    timeout --foreground "$seconds" "$@"
  else
    "$@"
  fi
}

run_static() {
  echo
  echo "▶ Static quick checks"
  echo "------------------------------------------------------------"

  python3 - <<'PY'
from pathlib import Path

files = [
    "apps/web/app/static/css/ff.css",
    "apps/web/app/static/css/platform-home.css",
    "apps/web/app/static/css/campaign.css",
    "apps/web/app/static/css/dashboard.css",
    "apps/web/app/static/css/login.css",
    "apps/web/app/static/css/onboarding.css",
]

bad = False

for file in files:
    path = Path(file)
    if not path.exists():
        print(f"FAIL missing {file}")
        bad = True
        continue

    text = path.read_text(errors="ignore")
    opens = text.count("{")
    closes = text.count("}")

    if opens != closes:
        print(f"FAIL {file} brace mismatch: {{={opens} }}={closes}")
        bad = True
    else:
        print(f"PASS {file}")

raise SystemExit(1 if bad else 0)
PY
}

changed_files() {
  {
    git diff --name-only --diff-filter=ACMRTUXB
    git diff --cached --name-only --diff-filter=ACMRTUXB
  } | sort -u
}

changed_surfaces() {
  local files
  files="$(changed_files || true)"

  local surfaces=()

  if echo "$files" | grep -Eq '(^|/)platform-home\.css$|apps/web/app/templates/platform/index\.html|apps/web/app/static/js/ff-app\.js'; then
    surfaces+=("platform")
  fi

  if echo "$files" | grep -Eq '(^|/)campaign\.css$|apps/web/app/templates/campaign/|apps/web/app/templates/campaign_premium\.html|apps/web/app/static/js/ff-campaign\.js|apps/web/app/static/js/ff-checkout-direct\.js|apps/web/app/static/js/ff-embedded-checkout\.js|apps/web/app/static/js/ff-donation-payload-firewall\.js|apps/web/app/static/js/ff-sponsor-modal-contract\.js'; then
    surfaces+=("campaign")
  fi

  if echo "$files" | grep -Eq '(^|/)login\.css$|apps/web/app/templates/platform/login\.html|apps/web/app/static/js/ff-login\.js'; then
    surfaces+=("login")
  fi

  if echo "$files" | grep -Eq '(^|/)onboarding\.css$|apps/web/app/templates/platform/onboarding\.html|apps/web/app/static/js/islands/onboarding\.js'; then
    surfaces+=("onboarding")
  fi

  if echo "$files" | grep -Eq '(^|/)dashboard\.css$|apps/web/app/templates/platform/dashboard\.html|apps/web/app/templates/platform/dashboard_locked\.html|apps/web/app/static/js/ff-operator-dashboard\.js'; then
    load_operator_token
    if [[ -n "${FF_OPERATOR_ACCESS_TOKEN:-}" ]]; then
      surfaces+=("dashboard_locked,dashboard_operator")
    else
      surfaces+=("dashboard_locked")
    fi
  fi

  if [[ ${#surfaces[@]} -eq 0 ]]; then
    echo ""
    return 0
  fi

  local joined
  joined="$(IFS=,; echo "${surfaces[*]}")"
  echo "$joined" | sed 's/,,*/,/g'
}

surface_smoke() {
  local surfaces="$1"
  run_timed "Fast surface smoke: $surfaces" 45s node scripts/audit/ff_surface_smoke_fast.mjs "$surfaces"
}

case "$mode" in
  changed)
    run_static
    surfaces="$(changed_surfaces)"
    if [[ -z "$surfaces" ]]; then
      echo
      echo "▶ No uncommitted UI surface changes detected"
      echo "------------------------------------------------------------"
      echo "Static checks passed. Use scripts/dev/ffq ui or scripts/dev/ffq money for broader gates."
      exit 0
    fi
    surface_smoke "$surfaces"
    ;;

  platform|home)
    run_static
    surface_smoke "platform"
    ;;

  campaign)
    run_static
    surface_smoke "campaign"
    ;;

  login)
    run_static
    surface_smoke "login"
    ;;

  onboarding|launch)
    run_static
    surface_smoke "onboarding"
    ;;

  dashboard|dash)
    run_static
    surface_smoke "dashboard_locked"
    ;;

  operator|ops)
    run_static
    sync_operator_server_env
    surface_smoke "login,onboarding,dashboard_locked,dashboard_operator"
    ;;

  all)
    run_static
    load_operator_token
    if [[ -n "${FF_OPERATOR_ACCESS_TOKEN:-}" ]]; then
      surface_smoke "platform,campaign,login,onboarding,dashboard_locked,dashboard_operator"
    else
      surface_smoke "platform,campaign,login,onboarding,dashboard_locked"
    fi
    ;;

  buttons|functional)
    run_static
    load_operator_token
    run_timed "Functional button contracts" 120s node scripts/audit/ff_functional_button_contracts.mjs
    ;;

  e2e|product)
    run_static
    load_operator_token
    run_timed "E2E product audit" 260s python3 scripts/audit/ff_e2e_product_audit.py --run-buttons --run-visual
    ;;

  ui)
    run_static
    run_timed "Visual surface board" 90s node scripts/audit/ff_visual_surface_board.mjs
    ;;

  clip)
    run_static
    sync_operator_server_env
    run_timed "Header clip audit" 60s node scripts/audit/ff_header_clip_audit.mjs
    ;;

  ui-full)
    run_static
    sync_operator_server_env
    run_timed "Visual surface board" 90s node scripts/audit/ff_visual_surface_board.mjs
    run_timed "Header clip audit" 60s node scripts/audit/ff_header_clip_audit.mjs
    ;;

  prelive)
    run_static
    run_timed "Prelive UI gate" 240s scripts/audit/ff_prelive_ui_gate.sh
    ;;

  money)
    sync_operator_server_env
    run_timed "Money loop gate" 600s scripts/release/ff_money_loop_gate_local.sh
    ;;

  full)
    run_static
    sync_operator_server_env
    run_timed "Prelive UI gate" 240s scripts/audit/ff_prelive_ui_gate.sh
    run_timed "Money loop gate" 600s scripts/release/ff_money_loop_gate_local.sh
    ;;

  -h|--help|help)
    usage
    ;;

  *)
    usage
    exit 2
    ;;
esac
