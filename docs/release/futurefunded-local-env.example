# =========================================================
# FutureFunded — Local Dev Env
# Local only. Do not commit this file with real secrets.
# Copy values into .env if your loader expects .env.
# =========================================================

APP_NAME=FutureFunded
APP_ENV=development
ENV=development
FLASK_ENV=development
FF_ENV=development

WEB_HOST=127.0.0.1
WEB_PORT=5000
API_HOST=127.0.0.1
API_PORT=8000
PUBLIC_BASE_URL=http://127.0.0.1:5000
API_BASE_URL=http://127.0.0.1:8000
PREFERRED_URL_SCHEME=http

SECRET_KEY=replace-with-generated-local-secret
DATABASE_URL=sqlite:///instance/futurefunded-dev.db

FF_PAYMENTS_ENABLED=1
FF_STRIPE_ENABLED=1
STRIPE_MODE=test
STRIPE_PUBLIC_KEY=pk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
FF_STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_WEBHOOK_SIGNING_SECRET=whsec_REPLACE_ME
FF_EXPECT_TEST_PAYMENTS=1
FF_FORBID_LIVE_KEYS=1
FF_STRIPE_ENFORCE_LIVE_KEYS=0

PAYPAL_MODE=disabled
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD

FF_EMAIL_DRY_RUN=1
FF_EMAIL_FROM=support@getfuturefunded.com
FF_EMAIL_REPLY_TO=support@getfuturefunded.com
FF_OPERATOR_NOTIFY_EMAIL=arodgps@gmail.com
FF_SMTP_HOST=
FF_SMTP_PORT=587
FF_SMTP_USERNAME=
FF_SMTP_PASSWORD=
FF_SMTP_USE_TLS=1
FF_SMTP_USE_SSL=0

DEMO_MODE=preview
DEMO_ORG_SLUG=connect-atx-elite
DEMO_ORGANIZATION_NAME="Connect ATX Elite"
DEMO_CAMPAIGN_SLUG=connect-atx-elite
DEMO_CAMPAIGN_NAME="Connect ATX Elite Season Fund"
DEMO_LOCATION="Austin, TX"
DEMO_HEADLINE="Fuel the season. Fund the future."
DEMO_SUBHEAD="Back the athletes."
