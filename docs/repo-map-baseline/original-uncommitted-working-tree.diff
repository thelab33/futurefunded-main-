 /* === FutureFunded Phase 2B Mobile Sticky Rail Safe Disable END === */
+
+/* === FutureFunded Phase 2C Campaign Fixed Header Offset START === */
+/*
+  Marker: hoi-phase2c-campaign-fixed-header-offset-v1
+  Scope: public campaign fixed header + first hero spacing only.
+  Reason:
+  - Rendered screenshots show the fixed campaign header overlaying the hero/top-fold.
+  - Keep header fixed, but reserve enough top runway for mobile/tablet/desktop.
+  - No template edits. No checkout/sponsor/share/QR hook edits.
+*/
+@layer campaign {
+  body.ff-campaignBody {
+    --ff-campaign-header-offset: clamp(5.75rem, 7.5vw, 7.75rem);
+  }
+
+  body.ff-campaignBody .ff-campaignPage,
+  body.ff-campaignBody .ff-campaignMain {
+    padding-top: var(--ff-campaign-header-offset) !important;
+  }
+
+  body.ff-campaignBody .ff-campaignHero {
+    margin-top: 0 !important;
+    scroll-margin-top: calc(var(--ff-campaign-header-offset) + 1rem) !important;
+  }
+
+  body.ff-campaignBody .ff-campaignHeader.ff-siteHeader,
+  body.ff-campaignBody .ff-campaignHeader.ffShellHeader {
+    top: max(0.5rem, env(safe-area-inset-top)) !important;
+    z-index: 120 !important;
+  }
+
+  body.ff-campaignBody .ff-campaignHeader .ff-siteHeader__shell,
+  body.ff-campaignBody .ff-campaignHeader .ffShellHeader__shell {
+    min-height: 3.5rem !important;
+  }
+
+  @media (max-width: 767px) {
+    body.ff-campaignBody {
+      --ff-campaign-header-offset: 7.25rem;
+    }
+
+    body.ff-campaignBody .ff-campaignPage,
+    body.ff-campaignBody .ff-campaignMain {
+      padding-top: var(--ff-campaign-header-offset) !important;
+    }
+
+    body.ff-campaignBody .ff-campaignHeader .ff-siteHeader__shell,
+    body.ff-campaignBody .ff-campaignHeader .ffShellHeader__shell {
+      min-height: 3.75rem !important;
+    }
+  }
+
+  @media (min-width: 768px) and (max-width: 1023px) {
+    body.ff-campaignBody {
+      --ff-campaign-header-offset: 6.25rem;
+    }
+  }
+
+  @media (min-width: 1024px) {
+    body.ff-campaignBody {
+      --ff-campaign-header-offset: 6.75rem;
+    }
+  }
+}
+/* === FutureFunded Phase 2C Campaign Fixed Header Offset END === */
