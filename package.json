{
  "name": "futurefunded-tooling",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10",
  "engines": {
    "node": ">=20.18 <21",
    "npm": ">=10"
  },
  "scripts": {
    "lint": "run-s lint:css lint:js lint:html",
    "lint:js": "node scripts/release/ff_npm_js_lint.mjs",
    "lint:html": "python scripts/release/ff_html_lint.py",
    "lint:css:fix": "stylelint \"apps/web/app/static/css/**/*.css\" --allow-empty-input --fix",
    "format": "prettier --write .",
    "format:write": "prettier --write .",
    "format:check": "prettier --check .",
    "test:js": "node scripts/run_js_contracts_with_api.mjs",
    "test:e2e": "playwright test",
    "audit:frontend": "python scripts/audit_active_frontend.py",
    "audit:css-active": "python scripts/audit_active_frontend.py",
    "audit:frontend:env": "python scripts/audit_active_frontend.py",
    "smoke:pages": "python scripts/smoke_product_pages.py",
    "qa:frontend": "npm run audit:frontend && npm run smoke:pages",
    "screens:product": "node scripts/capture_product_screenshots.mjs",
    "screens:product:onboarding": "INCLUDE_ONBOARDING=1 node scripts/capture_product_screenshots.mjs",
    "qa:visual": "npm run qa:frontend && npm run screens:product",
    "visual:zip": "rm -f futurefunded-visual-qa.zip && zip -r futurefunded-visual-qa.zip artifacts/frontend-screenshots && ls -lh futurefunded-visual-qa.zip",
    "qa:visual:onboarding": "npm run qa:frontend && npm run screens:product:onboarding && npm run visual:zip",
    "test:functionality": "node scripts/test_product_functionality.mjs",
    "qa:handoff": "npm run qa:frontend && npm run test:functionality",
    "qa:handoff:strict": "FF_STRICT_FUNCTIONAL=1 npm run qa:handoff",
    "qa:quality": "run-s lint format:check test:js qa:frontend",
    "shot:campaign": "node scripts/capture-campaign-screenshot.mjs",
    "shot:campaign:open": "npm run shot:campaign && (xdg-open artifacts/screenshots 2>/dev/null || open artifacts/screenshots 2>/dev/null || true)",
    "verify:campaign": "python scripts/verify_campaign_surface.py",
    "verify:campaign:modals": "node scripts/verify-campaign-modals.mjs",
    "shot:campaign:modals": "node scripts/capture-campaign-modals.mjs",
    "verify:campaign:payments": "node scripts/verify-campaign-payments.mjs",
    "verify:campaign:launch": "node scripts/verify-campaign-launch.mjs",
    "verify:homepage": "node scripts/verify-homepage-surface.mjs",
    "shot:homepage": "node scripts/capture-homepage-screenshot.mjs",
    "shot:homepage:open": "npm run shot:homepage && (xdg-open artifacts/frontend-screenshots 2>/dev/null || open artifacts/frontend-screenshots 2>/dev/null || true)",
    "verify:homepage:launch": "node scripts/verify-homepage-launch.mjs",
    "verify:headers": "node scripts/verify-header-convergence.mjs",
    "verify:css:ownership": "npm run audit:css:duplication",
    "audit:css:duplication": "node scripts/audit-css-duplication.mjs",
    "verify:css": "npm run audit:css:duplication",
    "audit:homepage:css-contract": "node scripts/audit-homepage-css-contract.mjs",
    "qa:launch:local": "bash scripts/launch/ff_run_full_local_suite.sh http://127.0.0.1:5000",
    "qa:launch:public": "bash scripts/launch/ff_run_full_local_suite.sh https://getfuturefunded.com",
    "qa:release:claims:local": "bash scripts/release/ff_verify_release_claims.sh http://127.0.0.1:5000",
    "qa:release:claims:public": "bash scripts/release/ff_verify_release_claims.sh https://getfuturefunded.com",
    "verify:analytics": "node scripts/release/verify-analytics-events.mjs",
    "verify:escape-close": "node scripts/release/verify-escape-close-hardening.mjs",
    "verify:layers": "node scripts/release/verify-layer-hygiene.mjs",
    "verify:checkout:stable": "bash scripts/release/verify-checkout-flow-stability.sh",
    "qa:conversion:local": "bash scripts/release/ff_run_prelive_conversion_suite.sh http://127.0.0.1:5000",
    "qa:conversion:public": "bash scripts/release/ff_run_prelive_conversion_suite.sh https://getfuturefunded.com",
    "verify:conversion": "node scripts/release/verify-conversion-behavior.mjs",
    "verify:referrals": "node scripts/release/verify-referral-attribution.mjs",
    "verify:stripe:test": "node scripts/release/verify-stripe-test-checkout.mjs",
    "doctor": "bash scripts/release/ff-master-product-doctor.sh",
    "doctor:heavy": "FF_DOCTOR_HEAVY=1 bash scripts/release/ff-master-product-doctor.sh",
    "doctor:all": "FF_DOCTOR_ALL=1 FF_DOCTOR_SECURITY=1 bash scripts/release/ff-master-product-doctor.sh",
    "lint:css": "node scripts/release/ff_npm_css_lint.mjs",
    "board:campaign": "node scripts/release/ff_campaign_visual_board_lite.mjs",
    "board": "npm run board:campaign",
    "board:home": "node scripts/release/ff_homepage_screenshot_board.mjs",
    "audit:homepage-board": "node scripts/release/ff_homepage_screenshot_board.mjs",
    "board:surfaces": "node scripts/release/ff_surface_lock_board.mjs",
    "audit:surface-lock": "node scripts/release/ff_surface_lock_board.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.0",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "htmlhint": "^1.9.2",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.60.0",
    "prettier": "^3.6.2",
    "stylelint": "^17.6.0",
    "stylelint-config-standard": "^40.0.0"
  },
  "stylelint": {
    "extends": [
      "stylelint-config-standard"
    ],
    "ignoreFiles": [
      "**/node_modules/**",
      "**/playwright-report*/**",
      "**/test-results/**",
      "**/dist/**",
      "**/coverage/**",
      "**/.venv/**",
      "**/artifacts/**"
    ],
    "rules": {
      "rule-empty-line-before": null,
      "comment-empty-line-before": null,
      "no-duplicate-selectors": null,
      "block-no-empty": null,
      "property-no-deprecated": null,
      "no-descending-specificity": null,
      "selector-class-pattern": null,
      "selector-id-pattern": null,
      "selector-not-notation": null,
      "property-no-vendor-prefix": null,
      "alpha-value-notation": null,
      "color-function-alias-notation": null,
      "color-function-notation": null,
      "color-hex-length": null,
      "custom-property-empty-line-before": null,
      "custom-property-pattern": null,
      "declaration-block-no-redundant-longhand-properties": null,
      "declaration-block-single-line-max-declarations": null,
      "font-family-name-quotes": null,
      "keyframes-name-pattern": null,
      "media-feature-range-notation": null,
      "shorthand-property-no-redundant-values": null,
      "value-keyword-case": null,
      "function-no-unknown": [
        true,
        {
          "ignoreFunctions": [
            "color-mix",
            "env"
          ]
        }
      ]
    }
  }
}
